{
  "name": "courseflow-framework",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Courseflow 后端运行时、HTTP API 与平台模块宿主",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts serve",
    "start": "node src/main.ts serve",
    "serve": "node src/main.ts serve",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "cli": "node src/main.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "fastify": "^5.12.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/server/app.ts"
  }
}
