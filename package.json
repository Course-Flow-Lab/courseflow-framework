{
  "name": "courseflow-framework",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "基于 Node.js 的课程工作台与平台模块宿主",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts serve",
    "start": "node src/main.ts serve",
    "serve": "node src/main.ts serve",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "check:web": "node scripts/check-web.mjs",
    "cli": "node src/main.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true
  }
}
